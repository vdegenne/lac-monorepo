{
	"name": "lac-run",
	"version": "0.1.5",
	"author": "Valentin Degenne <vdegenne@gmail.com>",
	"description": "A simple one-value clipboard running on your local network.",
	"type": "module",
	"files": [
		"./dist/*.js",
		"!./dist/*.js.map"
	],
	"bin": {
		"lac-run": "dist/index.js",
		"lac": "dist/index.js"
	},
	"scripts": {
		"build": "wireit",
		"start": "wireit"
	},
	"wireit": {
		"start": {
			"service": true,
			"command": "node ./lib/index.js",
			"dependencies": [
				"build"
			]
		},
		"build": {
			"dependencies": [
				"../api:build",
				"build:ts",
				"build:rollup"
			]
		},
		"build:rollup": {
			"command": "rollup -c",
			"dependencies": [
				"build:ts"
			],
			"files": [
				"./lib/",
				"./rollup.config.js"
			],
			"output": [
				"./dist"
			]
		},
		"build:ts": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"dependencies": [
				"../api:build"
			],
			"files": [
				"./tsconfig.json",
				"./src"
			],
			"output": [
				"./lib"
			]
		}
	},
	"devDependencies": {
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@types/koa": "^3.0.3",
		"@types/ws": "^8.18.1",
		"rollup": "^4.62.4",
		"typescript": "^7.0.2",
		"wireit": "^0.14.13",
		"lac-api": "0.1.0"
	},
	"dependencies": {
		"koa": "^3.2.1",
		"ws": "^8.21.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vdegenne/lac-monorepo.git"
	},
	"homepage": "https://github.com/vdegenne/lac-monorepo#readme",
	"bugs": {
		"url": "https://github.com/vdegenne/lac-monorepo/issues"
	}
}
