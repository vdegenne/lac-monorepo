{
	"name": "lac-stt-frontend",
	"version": "1.0.0",
	"description": "Speech-to-text webapp for LAC.",
	"type": "module",
	"author": "Valentin Degenne <vdegenne@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": ""
	},
	"scripts": {
		"dev": "wireit",
		"build": "wireit",
		"build:server": "wireit"
	},
	"wireit": {
		"dev": {
			"dependencies": [
				"dev:vite"
			]
		},
		"build": {
			"dependencies": [
				"build:vite"
			]
		},
		"build:server": {
			"command": "tsc -p ./tsconfig.server.json",
			"clean": "if-file-deleted",
			"files": [
				"./tsconfig.server.json",
				"./src/server/"
			],
			"output": [
				"./lib/server/"
			]
		},
		"serve:server": {
			"service": true,
			"command": "node ./lib/server.js",
			"dependencies": [
				"build:server"
			],
			"files": []
		},
		"vuc": {
			"service": true,
			"command": "vuc",
			"files": [
				"./.vuc.json"
			]
		},
		"dev:vite": {
			"service": true,
			"command": "vite --host",
			"dependencies": [
				"vuc"
			]
		},
		"build:vite": {
			"command": "vite build",
			"dependencies": [
				"../api:build"
			],
			"files": [
				"./vite.config.js",
				"./src/",
				"!./src/server/",
				"./index.html",
				"./public"
			],
			"output": [
				"./dist/"
			]
		}
	},
	"devDependencies": {
		"@material/mwc-top-app-bar": "^0.27.0",
		"@material/web": "^2.5.0",
		"@snar/lit": "^1.8.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/koa": "^3.0.3",
		"@types/ws": "^8.18.1",
		"@vdegenne/about-dialog": "^0.4.2",
		"@vdegenne/debouncer": "^1.0.17",
		"@vdegenne/forms": "^0.1.73",
		"@vdegenne/lit-debug": "^0.1.2",
		"@vdegenne/material-color-helpers": "^1.11.7",
		"@vdegenne/mini-rest": "^0.3.8",
		"@vdegenne/rollup-plugin-minify-html": "^1.0.6",
		"@vdegenne/router": "^0.1.11",
		"custom-element-decorator": "^0.6.0",
		"html-vision": "^1.0.5",
		"lac-api": "*",
		"lit": "^3.3.3",
		"lit-with-styles": "^2.1.3",
		"material-3-dialog": "^0.1.14",
		"material-shell": "^1.3.10",
		"rollup-plugin-material-all": "^1.2.2",
		"rollup-plugin-minify-template-literals": "^2.1.0",
		"snar": "^2.3.7",
		"snar-save-to-local-storage": "^1.0.1",
		"tailwindcss": "^4.3.3",
		"toastit": "^2.2.5",
		"typescript": "^7.0.2",
		"vite": "^7.3.6",
		"vite-plugin-mdicon2svg": "^0.2.3",
		"vscode-ui-connector": "^0.2.4",
		"wireit": "^0.14.13"
	},
	"dependencies": {
		"koa": "^3.2.1",
		"ws": "^8.21.3"
	}
}
