{
	"name": "lac-api",
	"version": "0.1.3",
	"author": "Valentin Degenne <vdegenne@gmail.com>",
	"type": "module",
	"main": "./lib/index.js",
	"scripts": {
		"build": "wireit"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"files": [
				"./tsconfig.json",
				"./src"
			],
			"output": [
				"./lib"
			]
		}
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"wireit": "^0.14.13"
	},
	"dependencies": {
		"@vdegenne/mini-rest": "^0.3.6"
	},
	"files": [
		"./lib/"
	]
}
