{
	"name": "lac-api",
	"version": "0.1.9",
	"author": "Valentin Degenne <vdegenne@gmail.com>",
	"type": "module",
	"main": "./lib/index.js",
	"exports": {
		".": {
			"import": "./lib/index.js",
			"types": "./lib/index.d.ts"
		},
		"./shared.js": {
			"import": "./lib/shared.js",
			"types": "./lib/shared.d.ts"
		}
	},
	"scripts": {
		"build": "wireit"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"files": [
				"./tsconfig.json",
				"./src"
			],
			"output": [
				"./lib"
			]
		}
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"wireit": "^0.14.13"
	},
	"dependencies": {
		"@snar/lit": "^1.8.1",
		"@vdegenne/mini-rest": "^0.3.8"
	},
	"files": [
		"./lib/"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vdegenne/lac-monorepo.git"
	},
	"homepage": "https://github.com/vdegenne/lac-monorepo#readme",
	"bugs": {
		"url": "https://github.com/vdegenne/lac-monorepo/issues"
	}
}
